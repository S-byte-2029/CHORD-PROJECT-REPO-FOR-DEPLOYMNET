# Django Backend Environment Variables Template
# Set these variables in Railway Project Dashboard (Variables tab)

# Security
SECRET_KEY=django-insecure-replace-this-with-a-very-long-random-key-in-production
DEBUG=False
ALLOWED_HOSTS=*.railway.app,localhost,127.0.0.1,.up.railway.app

# Database (Supabase PostgreSQL Connection URI with SSL)
# Format: postgresql://postgres:[PASSWORD]@[HOST].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres?sslmode=require

# CORS & CSRF Settings
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-site.netlify.app,https://*.netlify.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-site.netlify.app,https://*.netlify.app,https://*.railway.app

# Dynamic Port (Assigned automatically by Railway at runtime)
PORT=8000
PYTHONUNBUFFERED=1
